# Copy this file to .env on the target VM and fill in real values.
# DO NOT commit the actual .env file with real keys.

# ─── CapMonster Cloud (https://capmonster.cloud) ───────────────────────────
# Get your key from https://capmonster.cloud/dashboard
CAPMONSTER_ENABLED=true
CAPMONSTER_API_KEY=your_capmonster_api_key_here
CAPMONSTER_TIMEOUT_MS=180000
CAPMONSTER_POLL_INTERVAL_MS=3000

# ─── Concurrency tuning ────────────────────────────────────────────────────
# Tuned for a 2 CPU / 4 GB playwright-service and 4 CPU / 8 GB api.
# RAM-bound by BROWSER_POOL_SIZE (each Chromium headless uses ~300 MB).
NUM_WORKERS_PER_QUEUE=6
MAX_CONCURRENT_JOBS=8
BROWSER_POOL_SIZE=8
CRAWL_CONCURRENT_REQUESTS=8
MAX_CONCURRENT_PAGES=8

# ─── SearXNG (https://docs.searxng.org) ────────────────────────────────────
# Set up SearXNG in a separate stack at ~/.services/searxng/
# sharing the docker network named "backend" with Firecrawl.
# SEARXNG_ENDPOINT should resolve from inside the firecrawl-api container.
SEARXNG_ENDPOINT=http://searxng-core:8080
SEARXNG_ENGINES=google,bing,duckduckgo,brave,startpage
SEARXNG_CATEGORIES=general

# ─── API auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Required for /v2/* endpoints so the stack isn't open to the world.
TEST_API_KEY=replace_with_openssl_rand_hex_32
